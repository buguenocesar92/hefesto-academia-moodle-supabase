# Copiar a .env SOLO en servidor. No subir a Git.
# Contrato auditable de variables: ninguna tiene valor real.
MOODLE_URL=https://academia.tu-dominio.cl
APP_URL=https://academia.tu-dominio.cl
APP_HOST=academia.tu-dominio.cl
# Supabase > Connect > Direct connection (no API URL, no pooler)
DB_HOST=db.REEMPLAZAR.supabase.co
DB_NAME=postgres
DB_USER=moodle_app
DB_PASSWORD=GENERAR
# DB_SSLMODE tiene precedencia; DB_SSL se conserva por compatibilidad.
DB_SSLMODE=require
DB_SSL=require
# verify-full exige la CA en certs/supabase-ca.crt.
HEFESTO_ALLOW_INSECURE_DB=0
SUPABASE_DEDICATED_CONFIRMED=true
SUPABASE_DATA_API_DISABLED=true
INITIAL_SETUP_COMPLETE=false
