# Copiar a .env SOLO en servidor. No subir a Git.
MOODLE_URL=https://academia.tu-dominio.cl
# Supabase > Connect > Direct connection (no API URL, no pooler)
DB_HOST=db.REEMPLAZAR.supabase.co
DB_NAME=postgres
DB_USER=moodle_app
DB_PASSWORD='REEMPLAZAR_PASSWORD_LARGO_UNICO'
# DB_SSLMODE tiene precedencia. DB_SSL se conserva por compatibilidad con
# .env antiguos cuyo nombre era DB_SSL (en ese caso equivalia a require).
# require cifra el trafico; verify-full ademas verifica identidad con
# certs/supabase-ca.crt. disable/allow/prefer requieren ademas
# HEFESTO_ALLOW_INSECURE_DB=1 (opt-in para Postgres interno sin TLS).
DB_SSLMODE=require
