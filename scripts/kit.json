{
  "software": "hefesto-academia",
  "version": "5.3",
  "database": "supabase-postgresql",
  "piezas": [
    "public.dump",
    "moodledata.tar.gz"
  ],
  "requiere": [
    "web"
  ],
  "arranca": [
    "web"
  ],
  "pasos": [
    [
      "stop",
      "web"
    ],
    [
      "pieza",
      "public.dump"
    ],
    [
      "pieza",
      "moodledata.tar.gz"
    ]
  ],
  "comandos": {
    "public.dump": [
      "run",
      "--rm",
      "--no-deps",
      "-T",
      "--entrypoint",
      "pg_dump",
      "dbtools",
      "--format=custom",
      "--schema=public",
      "--no-owner",
      "--no-acl"
    ],
    "moodledata.tar.gz": [
      "run",
      "--rm",
      "--no-deps",
      "-T",
      "--entrypoint",
      "tar",
      "web",
      "-czf",
      "-",
      "-C",
      "/var/moodledata",
      "."
    ]
  },
  "env_requeridas": [
    "MOODLE_URL",
    "DB_HOST",
    "DB_NAME",
    "DB_USER",
    "DB_PASSWORD",
    "DB_SSLMODE"
  ],
  "env_secretas": [
    "DB_PASSWORD"
  ],
  "env_min_len": 32,
  "env_reglas": []
}
